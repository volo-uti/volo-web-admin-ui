{
  "name": "@volo-uti/volo-web-admin-ui",
  "version": "0.1.0",
  "description": "Admin screen parts (shell, sidebar, page header, list toolbar, data table) built on @volo-uti/volo-web-ui",
  "keywords": [
    "volo",
    "admin",
    "backoffice",
    "react",
    "tailwindcss"
  ],
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/volo-uti/volo-web-admin-ui.git"
  },
  "homepage": "https://github.com/volo-uti/volo-web-admin-ui#readme",
  "bugs": {
    "url": "https://github.com/volo-uti/volo-web-admin-ui/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "volo-web-admin-ui-index": "./bin/volo-web-admin-ui-index.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "bin"
  ],
  "scripts": {
    "build": "tsup",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm check:css-vars && pnpm check:index && pnpm check:docs && pnpm test && pnpm build && pnpm check:dist",
    "check:css-vars": "node scripts/check-css-vars.mjs",
    "check:docs": "node scripts/component-docs.mjs --check",
    "check:dist": "node scripts/check-dist.mjs",
    "check:index": "node scripts/agent-index.mjs --check",
    "clean": "rm -rf dist storybook-static node_modules",
    "dev": "tsup --watch",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "index": "node scripts/agent-index.mjs && node scripts/component-docs.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && lefthook install || true",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "bash scripts/verify"
  },
  "peerDependencies": {
    "@volo-uti/volo-web-ui": "^0.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-docs": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@volo-uti/volo-web-ui": "^0.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "10.6.5",
    "globals": "^17.0.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^30.1.3",
    "lefthook": "catalog:",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.6.5",
    "tailwindcss": "^4.0.6",
    "tsup": "^9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.16.1"
}
